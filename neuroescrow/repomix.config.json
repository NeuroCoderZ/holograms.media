{
  "output": {
    "filePath": "repomix-output.md",
    "style": "xml",
    "removeComments": false,
    "showLineNumbers": true,
    "topFilesLength": 10
  },
  "include": [
    "**/*.py",
    "**/*.html",
    "**/*.css",
    "**/*.js",
    "index.html",
    "css/style.css",
    "js/app.js",
    "js/telegram.js",
    "js/charts.js",
    "backend/src/**/*.py"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "node_modules/**",
      "__pycache__/**",
      "*.pyc",
      ".venv/**",
      "venv/**",
      "dist/**",
      "build/**",
      "*.log",
      ".env*",
      "*.key",
      "*.pem",
      "wrangler.toml",
      "repomix-output.md",
      "reports/**",
      "backend/RAG_CONFIG.md",
      "backend/QUESTION_FOR_GROK.md",
      "backend/README.md",
      "backend/astra_connector.py",
      "backend/memory/**",
      "backend/scripts/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
