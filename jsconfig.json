{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "tests",
    "public",
    "qdrant_local",
    "holographic_core",
    "dist",
    ".git",
    "docs",
    "sample_data"
  ]
}