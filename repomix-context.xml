  color: #888 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--border-radius-md);
  transition: all 0.15s ease-in-out !important;
  font-size: 24px !important;
  /* Keep icon size large */
}

/* Increased size for playback transport icons and Add button */
#loadAudioButton svg,
#playAudioButton svg,
#stopAudioButton svg {
  width: 28px !important;
  height: 28px !important;
}

.control-button svg {
  width: 24px !important;
  height: 24px !important;
  transition: all 0.15s ease-in-out !important;
  fill: currentColor !important;
  pointer-events: none;
}

.control-button img {
  width: var(--icon-size);
  height: var(--icon-size);
  transition: all 0.2s ease;
  filter: brightness(0) invert(0.7);
  pointer-events: none;
}

.control-button:not(:disabled):hover {
  color: white !important;
  /* Hover: White */
  transform: scale(1.05);
}

.control-button.active {
  color: white !important;
  /* Active/Toggled: White */
}

.control-button:disabled {
  color: #444 !important;
  /* Disabled/Inactive: Dark gray */
  cursor: not-allowed;
  transform: none;
}

/* Общий стиль для SVG внутри кнопок */
/* SVG and icons inside buttons inherit color */
.control-button svg,
.control-button img {
  width: var(--icon-size);
  height: var(--icon-size);
  fill: currentColor !important;
  transition: all 0.15s ease-in-out !important;
}

/* Cleanup redundant rules */

/* Логика иконок */
.google-login-button {
  background-color: #4285F4;
  /* Google Blue */
  color: white;
  border-color: #4285F4;
}

.google-login-button:hover {
  background-color: #357ae8;
  border-color: #357ae8;
}

/* Ensure avatar button is more like an icon button if it's just an icon */

/* Styling for the icon-only Google login button */
#login-google-btn.control-button {
  background-color: transparent;
  /* Override Google Blue */
  color: var(--color-icon);
  /* Standard icon color */
  border: none;
  /* Remove border if any from panel-button or social-login-button */
  width: var(--button-size);
  /* Ensure square size like other control buttons */
  height: var(--button-size);
  padding: 0;
  /* Reset padding */
  display: flex;
  align-items: center;
  justify-content: center;
  /* margin-left: auto; */
  /* Ensure it behaves like other control buttons in a flex/grid */
  /* margin-right: auto; */
}

#login-google-btn.control-button svg {
  width: 20px !important;
  height: 20px !important;
  color: currentColor;
}

#login-google-btn.control-button:hover {
  background-color: var(--button-hover-bg);
  /* Standard hover background */
  color: var(--color-icon-active);
  /* Standard active icon color */
}
