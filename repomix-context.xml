<file path="Dockerfile">
# Этап 1: "Строительный" этап - установка всех зависимостей
FROM python:3.11-slim-bullseye AS builder

# Устанавливаем переменные окружения
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

WORKDIR /app

# Копируем только файл с зависимостями
COPY backend/requirements.txt .

# Устанавливаем зависимости. На этом этапе образ будет большим.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Этап 2: "Финальный" этап - создание маленького образа
FROM python:3.11-slim-bullseye AS final

# Устанавливаем Node.js (нужен для GestureBot)
RUN apt-get update && apt-get install -y \
    curl \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Копируем package.json
COPY package.json .

# Устанавливаем Node.js зависимости
RUN npm install

# Устанавливаем переменные окружения
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV PYTHONPATH=/app

WORKDIR /app

# Копируем ТОЛЬКО установленные библиотеки из "строительного" этапа
# Это ключевой шаг для уменьшения размера
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Копируем наш код и фронтенд-ресурсы в финальный образ
COPY ./backend /app/backend
COPY ./scripts /app/scripts
COPY ./js /app/js
COPY ./css /app/css
COPY ./public /app/public
COPY ./icons /app/icons
COPY ./holocore /app/holocore

# Копируем корневые файлы для статики
COPY ./index.html /app/index.html
COPY ./style.css /app/style.css
COPY ./favicon.ico /app/favicon.ico
COPY ./manifest.json /app/manifest.json
COPY ./sw.js /app/sw.js

# Указываем, что контейнер будет слушать на порту 8000
EXPOSE 8000

# Команда для запуска приложения.
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000"]
</file>

<file path="docs/EN/Architecture/ApiSpecifications.json">
{
  "api_info": {
    "title": "Holograms Media Backend API",
    "version": "1.0.0",
    "description": "Backend services for the Holograms.Media project providing endpoints for user interaction, media processing and the Tria AI assistant",
    "base_url": "https://api.holograms.media",
    "documentation_url": "/docs",
    "last_updated": "2025-09-26"
  },
  "authentication": {
    "type": "OAuth 2.0 with Google Sign-In",
    "description": "Most endpoints require authentication via JWT tokens issued after Google OAuth 2.0 validation"
  },
  "endpoints": [
    {
      "path": "/",
      "method": "GET",
      "description": "Root API endpoint with a welcome message",
      "tags": ["Root"],
      "responses": {
        "200": {
          "description": "Successful response",
          "content": {
            "application/json": {
              "example": {
                "message": "Welcome to the Holograms Media API. Visit /docs for API documentation."
              }
            }
          }
        }
      }
    },
    {
      "path": "/healthz",
      "method": "GET",
      "description": "FastAPI health check endpoint",
      "tags": ["System"],
      "responses": {
        "200": {
          "description": "Service is healthy",
          "content": {
            "application/json": {
              "example": {
                "status": "ok",
                "message": "FastAPI is healthy"
              }
            }
          }
        }
      }
    },
    {
      "path": "/upload-chunk",
      "method": "POST",
      "description": "Upload media chunks to Backblaze B2 with multipart support",
      "tags": ["Chunks"],
      "parameters": {
        "chunk": {
          "type": "file",
          "description": "Chunk file to upload"
        },
        "chunk_id": {
          "type": "string",
          "description": "Unique chunk identifier"
        },
        "file_id": {
          "type": "string",
          "description": "File identifier"
        },
        "part_number": {
          "type": "integer",
          "description": "Part number in multipart upload"
        },
        "upload_id": {
          "type": "string",
          "description": "Multipart upload session id"
        },
        "b2_bucket_name": {
          "type": "string",
          "description": "B2 bucket name for upload"
        }
      },
      "responses": {
        "200": {
          "description": "Chunk uploaded successfully",
          "content": {
            "application/json": {
              "example": {
                "success": true,
                "message": "Chunk 1 uploaded successfully.",
                "ETag": "\"abc123...\"",
                "PartNumber": 1,
                "file_id": "user_file.mp4",
                "upload_id": "upload123"
              }
            }
          }
        },
        "503": {
          "description": "Storage service unavailable"
        }
      }
    },
    {
      "path": "/api/v1/chunks/generate-upload-url",
      "method": "POST",
      "description": "Generate a presigned POST URL for direct upload to Cloudflare R2",
      "tags": ["Chunks"],
      "authentication": "Required",
      "request_body": {
        "filename": {
          "type": "string",
          "example": "myvideo.mp4",
          "description": "File name"
        },
        "content_type": {
          "type": "string",
          "example": "video/mp4",
          "description": "MIME type"
        }
      },
      "responses": {
        "200": {
          "description": "Presigned URL generated",
          "content": {
            "application/json": {
              "example": {
                "url": "https://r2-bucket-url.com",
                "fields": {
                  "Content-Type": "video/mp4",
                  "key": "user_uploads/uuid/filename.mp4"
                },
                "object_key": "user_uploads/uuid/filename.mp4"
              }
            }
          }
        },
        "401": {
          "description": "Unauthorized"
        },
        "503": {
          "description": "R2 service unavailable"
        }
      }
    },
    {
      "path": "/api/v1/chunks/upload_chunk/{user_id}",
      "method": "POST",
      "description": "Upload media chunks for a specific user to R2 with automatic metadata processing",
      "tags": ["Chunks"],
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User id"
        },
        "file": {
          "type": "file",
          "description": "Chunk file to upload"
        }
      },
      "responses": {
        "200": {
          "description": "Chunk uploaded and metadata processing started",
          "content": {
            "application/json": {
              "example": {
                "message": "Chunk uploaded successfully. Metadata processing initiated.",
