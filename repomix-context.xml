    if (process.argv[3] === 'train') {
        await trainGestureModel(gestureData);
    } else {
        const prediction = await predictGesture(gestureData);
        console.log(JSON.stringify({ prediction }));
    }
}

if (require.main === module) {
    main().catch(console.error);
