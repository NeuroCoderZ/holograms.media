}

/* Область жестов */
/* Область жестов */
#gesture-area {
  position: fixed;
  bottom: calc(5svh + env(safe-area-inset-bottom));
  left: 0;
  width: 100%;
  height: 6px;
  background-color: rgba(50, 50, 50, 0.9);
  z-index: 10000;
  border: none;
  cursor: pointer;
  overflow: hidden;
  transition: width 0.3s cubic-bezier(0.25, 0.1, 0.25, 1), height 0.3s cubic-bezier(0.25, 0.1, 0.25, 1), background-color 0.3s ease;
  pointer-events: auto;
}

/* Активная область жестов */
#gesture-area.hands-detected {
  background-color: rgba(0, 0, 0, 0.8);
  border: 1px solid var(--color-black-33);
  box-shadow: 0 -5px 20px rgba(0, 255, 136, 0.1);
  border-radius: 8px;
  /* Added slight rounding for premium feel */
}

/* Линия жестов - скрыта, так как отрисовка на холсте */
#gesture-line {
  display: none;
}

/* Стили для голограммы */
.hologram {
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), margin-bottom 0.5s ease;
  transform-origin: center bottom;
  will-change: transform, margin-bottom;
}

/* Эффект "Squash" (Поджатие) */
.main-area.squashed .hologram {
  /* Dynamic offset: base 5vh + panel height + 5vh gap */
  transform: translateY(-5%) scale(0.9) !important;
  margin-bottom: calc(var(--gesture-panel-height, 20vh) + 10vh) !important;
}

/* Старый селектор для совместимости, но лучше использовать .squashed */
/* Старый селектор для совместимости, но лучше использовать .squashed */
.gesture-area.active~.main-area .hologram,
.gesture-area.active+.main-area .hologram,
.gesture-area.hands-detected~.main-area .hologram,
.gesture-area.hands-detected+.main-area .hologram {
  /* Panel is ~25vh high + 5svh bottom offset = 30svh top. We want 5svh gap. So 35svh margin. */
  transform: scale(0.9) !important;
  margin-bottom: 35svh !important;
}
