<file path="css/_panels.css">
.panel.left-panel,
.panel.right-panel {
  background-color: rgba(16, 16, 32, 0.65) !important;
  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;
  padding: 0;
  /* Clear shared padding */
  height: 90svh !important;
  top: 5svh !important;
  flex: 0 0 auto;
  z-index: 1001;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.3);
  transition: transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1), opacity 0.3s ease-in-out !important;
  opacity: 0 !important;

  visibility: hidden !important;
  pointer-events: none !important;
  position: absolute;
}

.panel.left-panel {
  left: 0;
  width: 110px !important;
  transform: translateX(-100%) !important;
  overflow: hidden !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-start !important;
  gap: 8px !important;
  padding: 0 !important;
  padding-bottom: 75px !important;
  align-items: center !important;
}

.panel.right-panel {
  right: 0;
  width: var(--panel-width-right) !important;
  transform: translateX(100%) !important;
  display: flex !important;
  flex-direction: column !important;
}

/* Visible state triggered by JS classes */
.panel.left-panel.visible,
.panel.right-panel.visible {
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
  transform: translateX(0) !important;
  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;
  background-color: rgba(16, 16, 32, 0.4) !important;
}



/* --- Universal Layout Variables --- */
:root {
  /* Desktop Layout (Landscape) */
  --panel-width-left: clamp(280px, 20vw, 320px);
  --panel-width-right: clamp(320px, 25vw, 400px);
}

@media (orientation: portrait) or (max-width: 768px) {
  :root {
    /* Mobile Layout (Portrait) */
    --panel-width-left: 80px;
    /* Narrow strip for icons */
    --panel-width-right: 100vw;
    /* Full screen for chat/content */
  }
}



/* DESKTOP: '.visible' class restores panel dimensions and opacity */
.panel.left-panel.visible {
  transform: translateX(0) !important;
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
  overflow: hidden !important;
  transition-delay: 0s;
}

.panel.right-panel.visible {
  opacity: 1 !important;
  transform: translateX(0) !important;
  pointer-events: auto !important;
  visibility: visible !important;
  overflow-y: auto !important;
  transition-delay: 0s;
  touch-action: none !important;
  left: auto;
  right: 0;
}

/* DESKTOP: '.hidden' class support for toggling panels */
.panel.left-panel.hidden {
  transform: translateX(-100%) !important;
  opacity: 0 !important;
  pointer-events: none !important;
  visibility: hidden !important;
}

.panel.right-panel.hidden {
  transform: translateX(100%) !important;
  opacity: 0 !important;
  pointer-events: none !important;
  visibility: hidden !important;
}

/* --- Left Panel Restructure Styles --- */

.left-panel-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  gap: 2px;
  /* Very compact */
}

.left-panel-group.top-group {
  flex-direction: row !important;
  justify-content: center !important;
  gap: 10px !important;
  flex-wrap: nowrap !important;
  margin-top: 0 !important;
  /* Panel itself is offset by 5vh */
}

/* Styling for buttons in the top group of the left panel */
.left-panel-group.top-group .panel-button,
.left-panel-group.top-group .social-login-button {
  width: 45px !important;
  height: 48px !important;
  /* Match rectangular buttons */
  padding: 0;
  margin-left: auto;
  margin-right: auto;
}

.left-panel-group.central-block {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
  width: 100%;
  padding: 0 5px;
  justify-items: center;
  align-items: center;
}

/* Arrange buttons: odd ones (1st, 3rd, 5th...) in left column, even ones (2nd, 4th, 6th...) in right column */
.left-panel-group.central-block .control-button:nth-child(odd) {
  grid-column: 1;
}

.left-panel-group.central-block .control-button:nth-child(even) {
  grid-column: 2;
}

.panel-button {
  display: flex;
  align-items: center;
  justify-content: center;
  /* Center content (icon + text) */
  padding: var(--spacing-sm) var(--spacing-md);
  margin: 0;
  /* Remove default margins if any, rely on gap */
  width: 100%;
  /* Default to full width for stacking buttons */
  text-align: left;
  background-color: var(--input-bg);
  /* A slightly different bg for panel buttons */
  color: #888 !important;
  /* Force gray for panel buttons */
  border: 1px solid var(--panel-border);
  border-radius: var(--border-radius-md);
  font-size: var(--font-size-button);
  cursor: pointer;
  transition: all 0.15s ease-in-out !important;
}

.panel-button i {
  margin-right: var(--spacing-sm);
  /* Space between icon and text */
  font-size: calc(var(--icon-size) * 0.8);
  /* Slightly smaller icons in text buttons */
  width: calc(var(--icon-size) * 0.8);
  /* Ensure icon takes up defined space */
  text-align: center;
}

.panel-button .button-text {
  flex-grow: 1;
  /* Allow text to take remaining space */
}

.panel-button:hover,
.panel-button.active {
  background-color: var(--button-hover-bg);
  color: white !important;
  /* White on hover/active */
}

/* Unified styling for icon buttons on the left panel that might also have .panel-button */
/* This ensures they look like .control-buttons (transparent, no border from .panel-button) */
#left-panel .panel-button.control-button {
  background-color: transparent;
  border: none;
  padding: 0;
  /* Reset padding from .panel-button */
  /* width and height are primarily controlled by .control-button's !important */
  /* color is set by .control-button */
  /* font-size for icon is set by .control-button */
}

/* Hover specifically for these combined buttons, ensuring it matches .control-button hover */
#left-panel .panel-button.control-button:not(:disabled):hover {
  background-color: var(--button-hover-bg);
  color: white !important;
  /* Ensure icon color changes */
  transform: scale(1.05);
  transition: all 0.15s ease-in-out !important;
}

/* Ensure active state is also consistent */
#left-panel .panel-button.control-button.active {
  background-color: var(--button-hover-bg);
  color: white !important;
}






.left-panel-group.central-block .control-button.panel-button svg {
  width: var(--icon-size);
  height: var(--icon-size);
}




.google-login-button {
  background-color: #4285F4;
  /* Google Blue */
  color: white;
  border-color: #4285F4;
}

.google-login-button:hover {
  background-color: #357ae8;
  border-color: #357ae8;
}

.panel-hr {
  width: 80%;
  border: none;
  height: 1px;
  background-color: var(--panel-border);
  margin: 8px auto !important;
}

#left-panel .panel-hr:first-of-type {
  margin-top: 8px !important;
  margin-bottom: 8px !important;
}

#left-panel .panel-hr:last-of-type {
  margin-top: 15px !important;
  /* Space after Install button */
  margin-bottom: 8px !important;
}

.left-panel-group.bottom-group {
  display: flex !important;
  flex-direction: row !important;
  gap: 15px !important;
  width: 100%;
  padding: 0 10px;
  justify-content: center !important;
  align-items: center;
  flex-wrap: nowrap !important;
  margin-top: 0 !important;
  /* Content is pushed by the HR above it */
}

#telegramLinkButton svg {
  width: 36px !important;
  /* Reduced from 40px, but larger than 32px */
  height: 36px !important;
}

#githubButton svg {
  width: 24px !important;
  /* Restore standard size */
  height: 24px !important;
}

/* Bottom link hover transition moved to generic icon link */

.panel-icon-link {
  color: var(--color-icon);
  font-size: calc(var(--icon-size) * 1.2);
  /* Larger icons for bottom links */
  text-decoration: none;
  transition: color 0.2s ease;
  padding: var(--spacing-xs);
}

.panel-icon-link:hover {
  color: var(--color-icon-active);
}

/* Ensure avatar button is more like an icon button if it's just an icon */

/* Styling for the icon-only Google login button */
#login-google-btn.control-button {
  background-color: transparent;
  /* Override Google Blue */
  color: var(--color-icon);
  /* Standard icon color */
  border: none;
  /* Remove border if any from panel-button or social-login-button */
  width: var(--button-size);
  /* Ensure square size like other control buttons */
  height: var(--button-size);
  padding: 0;
  /* Reset padding */
  display: flex;
  align-items: center;
  justify-content: center;
  /* margin-left: auto; */
  /* Ensure it behaves like other control buttons in a flex/grid */
  /* margin-right: auto; */
}

#login-google-btn.control-button .fab.fa-google {
  font-size: var(--icon-size);
  /* Ensure icon size matches other control buttons */
  color: currentColor;
  /* Inherit color from the button itself */
}

#login-google-btn.control-button:hover {
  background-color: var(--button-hover-bg);
  /* Standard hover background */
  color: var(--color-icon-active);
  /* Standard active icon color */
}



/* --- End Left Panel Restructure Styles --- */

/* Removed old .panel.hidden styles as .visible class now controls visibility */

/* Стили для голограммы */
.hologram {
  transition: transform 0.5s ease-in-out, margin-top 0.5s ease-in-out !important;
  transform-origin: center center !important;
  will-change: transform, margin-top !important;
  margin-top: 5svh !important;
  margin-bottom: 5svh !important;
}

.gesture-area.active~.main-area .hologram,
.gesture-area.active+.main-area .hologram {
  transform: scale(0.8) !important;
  margin-top: 5svh !important;
}

/* Стили панелей */
.panel-section {
  transition: all 0.3s ease-in-out;
}

/* Ensure content inside panels is fully opaque */
.panel .control-button,
.panel .panel-button,
.panel .view-toggle-btn,
.panel .panel-icon-link,
.panel .panel-hr,
.panel .panel-section {
  opacity: 1 !important;
}

/* Стили для окон в правой панели с отступами 5% и закругленными углами */
#myHologramsView,
#myGesturesView,
#chatHistory {
  padding: 5% !important;
  border-radius: 15px !important;
  background-color: rgba(0, 0, 0, 0.3) !important;
  margin: 10px 0 !important;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2) !important;
}
</file>

<file path="css/_responsive.css">
/* ============================================= */
/* ==       MOBILE-FIRST RESPONSIVE STYLES      == */
/* ============================================= */

/* Применяется к экранам шириной до 768px (смартфоны, планшеты в портретном режиме) */
@media (max-width: 768px), (orientation: portrait) {

  /* --- СТИЛИ ПАНЕЛЕЙ (Overlay Mode) --- */

  .panel.left-panel,
  .panel.right-panel {
    position: fixed !important;
    top: 0 !important;
    height: 100dvh !important; /* Используем dvh для устранения скачков */
    z-index: 1500 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transition: transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1), opacity 0.3s ease !important;
  }

  .panel.left-panel {
    left: 0 !important;
    transform: translateX(-100%) !important;
    width: 80px !important;
  }

  .panel.right-panel {
    right: 0 !important;
    transform: translateX(100%) !important;
    width: 100vw !important;
    background-color: rgba(16, 16, 32, 0.95) !important; /* Чуть темнее фон для читаемости */
  }

  .panel.left-panel.visible,
  .panel.right-panel.visible {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transform: translateX(0) !important;
  }

  /* НЕ скрываем main-area при открытых панелях, чтобы был эффект Overlay */
  body.left-panel-open .main-area,
  body.right-panel-open .main-area {
    display: block !important;
  }

  /* --- ОБЛАСТЬ ЖЕСТОВ (Всегда снизу, 20vh) --- */
  #gesture-area {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 20vh !important;
    min-height: 180px !important;
    background-color: rgba(30, 30, 30, 0.8) !important;
    backdrop-filter: blur(5px);
    z-index: 1000 !important;
    border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
    display: block !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  /* Убираем изменение высоты при обнаружении рук на мобильных */
  #gesture-area.hands-detected {
    height: 20vh !important;
    min-height: 180px !important;
  }

  /* --- КОНТЕЙНЕР ГОЛОГРАММЫ --- */
  .main-area {
    height: 100dvh !important; /* Используем dvh */
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important; /* Запрещаем скролл здесь */
  }

  #grid-container {
    height: calc(100dvh - 20vh) !important; /* Адаптируем под dvh */
    min-height: calc(100dvh - 180px) !important;
    width: 100% !important;
    position: relative !important;
    z-index: 5 !important;
  }

  /* --- КНОПКА TOGGLE --- */
  #togglePanelsButton {
    bottom: 20px !important; /* Жесткая фиксация */
    top: auto !important;
    left: 20px !important;
    position: fixed !important;
    z-index: 2000 !important; /* Выше панелей */
    display: flex !important;
    visibility: visible !important;
    background-color: rgba(0, 0, 0, 0.5) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-radius: 50% !important;
    width: 50px !important;
    height: 50px !important;
  }

  /* --- ОСТАЛЬНЫЕ КОРРЕКТИРОВКИ --- */
  .left-panel-group.central-block {
    grid-template-columns: 1fr !important;
    padding: 10px 5px !important;
  }

  .panel.right-panel .content-container {
    height: calc(100% - 150px) !important;
  }
}
</file>

<file path="css/_timeline.css">
/* Правая панель (Таймлайн + Промпт) */
#versionTimeline,
#chatHistory {
  flex-grow: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 5px;
  scrollbar-width: thin;
  scrollbar-color: var(--color-icon-disabled) var(--color-pure-black);
  min-height: 100px;
  background-color: var(--color-pure-black);
}

#promptBar,
#chatInputBar {
  flex-shrink: 0;
  min-height: 120px;
  max-height: 200px;
  background-color: var(--color-pure-black);
  padding: 5px;
  display: flex;
  flex-direction: column;
}

#versionTimeline::-webkit-scrollbar {
  width: 5px;
}

#versionTimeline::-webkit-scrollbar-thumb {
  background: var(--color-icon-disabled);
  border-radius: 3px;
}

#versionTimeline::-webkit-scrollbar-track {
  background: var(--color-pure-black);
}

/* Черный фон трека */

/* Таймлайн: элементы */
.timeline-item {
  margin-bottom: 10px;
  opacity: 0.85;
  transition: opacity 0.2s ease;
}

.timeline-item .version-label {
  position: absolute !important;
  top: var(--spacing-sm) !important;
  left: var(--spacing-sm) !important;
  font-size: var(--font-size-small) !important;
  line-height: 1.4 !important;
  opacity: 0.7 !important;
  color: var(--text-color) !important;
  background: rgba(0, 0, 0, 0.5) !important;
  padding: var(--spacing-xs) var(--spacing-sm) !important;
  border-radius: var(--border-radius-sm) !important;
  z-index: 1 !important;
}

.version-frame {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin-bottom: calc(var(--font-size-small) * 1.4 - var(--font-size-small));
  padding: var(--spacing-sm);
  border-radius: var(--border-radius-sm);
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.version-frame:hover {
  background-color: rgba(255, 255, 255, 0.05);
}

/* Чуть заметнее ховер */
.version-frame.active {
  background-color: rgba(255, 255, 255, 0.1);
  border-left: 2px solid var(--color-green-100);
}

.version-placeholder {
  background-color: rgba(0, 0, 0, 0.2);
  border-radius: var(--border-radius-sm);
  color: var(--color-primary);
  text-align: center;
  /* Используем переменные для определения размеров */
  width: calc(var(--font-size-small) * 1.4 * 5 + var(--spacing-md));
  /* Ширина = Высота */
  height: calc(var(--font-size-small) * 1.4 * 5 + var(--spacing-md));
  /* Высота для 5 строк текста + padding */
}

.version-text {
  padding-left: var(--spacing-md);
}

.version-text p {
  margin: 0;
  font-size: var(--font-size-small);
  line-height: 1.4;
  white-space: normal;
  overflow-y: auto;
  overflow-x: hidden;
  height: calc(var(--font-size-small) * 1.4 * 5);
  /* Высота для 5 строк текста */
  scrollbar-width: thin;
  scrollbar-color: var(--color-black-66) var(--color-black-95);
}
</file>

<file path="css/_utility.css">
/* Utility class for initial hiding to prevent FOUC */
.u-initially-hidden {
  opacity: 0 !important;
}

/* Styles for highlighting elements and dimming the background */
body.dimmed>*:not(.highlight) {
  opacity: 0.25;
  pointer-events: none;
  transition: opacity 0.5s ease-in-out;
}

.highlight {
  opacity: 1 !important;
  /* Ensure highlighted element is fully visible */
  pointer-events: auto !important;
  /* Ensure highlighted element is interactive */
  box-shadow: 0 0 15px 5px rgba(0, 255, 132, 0.7);
  /* Greenish glow */
  border-radius: 50%;
  /* Make the highlight area circular - adjust if needed */
  transition: box-shadow 0.3s ease-in-out;
  position: relative;
  /* For z-index to take effect */
  z-index: 9999;
  /* High z-index to be on top */
}

/* If using a separate overlay div instead of body class: */

.highlighted-element {
  position: relative;
  /* Needed for z-index to work reliably */
  z-index: 9999 !important;
  /* Ensure highlighted element is on top */
  opacity: 1 !important;
  /* Ensure highlighted element is fully visible */
  pointer-events: auto !important;
  /* Allow interaction with highlighted element */
  border-radius: 5px;
  /* Optional: adds rounded corners to the highlight effect */
  transition: box-shadow 0.3s ease-in-out, outline 0.3s ease-in-out;
  /* Smooth transitions if animation is removed/paused */
}

/* --- Interactive Tour Styles --- */
body.dimmed-for-tour>*:not(.highlighted-element) {
  opacity: 0.25 !important;
  /* Ensure this overrides other opacity styles */
  pointer-events: none !important;
  /* Prevent interaction with non-highlighted elements */
  transition: opacity 0.5s ease-in-out;
}

/* --- PWA Install Button Styles --- */
.pwa-install-button {
  display: none;
  /* Hidden by default */
}

.pwa-install-button.visible {
  display: flex;
  /* Or 'block', or 'grid', depending on how .control-button.panel-button is styled */
}

/* Скрыть мигающий курсор в пустых полях ввода */
textarea:placeholder-shown {
  caret-color: var(--color-white-100);
  /* Всегда показываем курсор */
}

/* Вернуть видимый курсор при фокусе, когда пользователь начинает вводить текст */
textarea:focus:not(:placeholder-shown) {
  caret-color: var(--color-white-100);
}

/* Обновление для placeholder в chat input, добавление пробела после "Tria" */
#chatInput::placeholder {
  letter-spacing: 0.2px;
  /* Небольшой отступ между символами */
  word-spacing: 3px;
  /* Увеличенный отступ между словами */
}

/* Автофокус в режиме чата */
.chat-mode {
  opacity: 1;
  transition: opacity 0.3s ease;
}

.chat-mode:focus-within {
  outline: none;
}

/* Разделительная линия */
.panel-divider {
  height: 1px;
  background-color: var(--panel-border);
  width: 100%;
  margin: calc(var(--spacing-sm) + 2px) 0;
  padding: 0;
  flex-shrink: 0;
  position: relative;
  border: none;
}

/* Контейнер для содержимого (верхняя часть панели) */
.content-container {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 200px;
  margin-bottom: 0;
  /* Убираем отступ для максимального приближения к линии */
}

/* Контейнер для ввода (средняя часть) */
.input-container {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  min-height: 120px;
  max-height: 200px;
  margin-top: 0;
  /* Убираем отступ для максимального приближения к линии */
}

/* Блок с элементами управления (нижняя часть панели) */
.controls-container {
  flex-shrink: 0;
  padding: 5px;
  background-color: transparent !important;
  display: flex;
  flex-direction: column;
  border-top: none;
  min-height: 40px;
  /* Replaced fixed height with min-height */
}

#chatButton.active {
  color: var(--color-icon-active);
}

#modelSelect {
  font-size: 14px;
  line-height: 1.4;
}

/* Стили для кода */
.code-block,
pre,
code,
#fileContent {
  font-family: 'Roboto Mono', monospace;
  /* Моноширинный шрифт для кода */
}

/* Классы шрифтов для разных элементов */
.font-interface {
  font-family: 'Inter', sans-serif;
}

.font-chat {
  font-family: 'Roboto', sans-serif;
}

.font-code {
  font-family: 'Roboto Mono', monospace;
}

.font-tooltip {
  font-family: 'Open Sans', sans-serif;
}

/* Применяем шрифты к конкретным элементам */
#versionTimeline .version-text p {
  font-family: 'Roboto', sans-serif;
}

.control-button,
.panel-section h3,
.prompt-controls select {
  font-family: 'Inter', sans-serif;
}

#topPromptInput,
#chatInput {
  font-family: 'Roboto', sans-serif;
}

#integratedFileEditor textarea {
  font-family: 'Roboto Mono', monospace;
}
</file>

<file path="css/_variables.css">
:root {
  /* Размеры */
  --base-size: clamp(8px, 1.5vmin, 14px);
  --button-spacing: 0.5vmin !important;
  --padding: clamp(5px, 1vmin, 8px);
  --button-size: clamp(44px, 5vmin, 60px) !important;
  --button-margin: clamp(6px, 1.5vmin, 14px);
  --icon-size: calc(var(--button-size) * 0.55);
  --text-size: calc(var(--button-size) * 0.35);
  --control-panel-height: calc(var(--button-size) + var(--button-margin) * 2);
  /* Используется как ширина левой панели */
  --timeline-width: clamp(20vw, 25vw, 30vw);
  /* Обновленная ширина правой панели */
  --line-width-vmin: 0.2vmin;
  /* !!! Возвращаем адаптивную ширину */

  /* Новые переменные для шрифтов */
  --font-size-base: clamp(13px, 1.8vmin, 16px);
  /* Основной размер текста */
  --font-size-small: clamp(11px, 1.5vmin, 14px);
  /* Мелкий текст (лейблы, метки) */
  --font-size-large: clamp(15px, 2vmin, 18px);
  /* Крупный текст (заголовки) */
  --font-size-button: clamp(14px, 1.8vmin, 16px);
  /* Текст на кнопках */
  --font-size-code: clamp(12px, 1.6vmin, 14px);
  /* Моноширинный текст */

  /* Новые переменные для элементов управления */
  --input-height: clamp(80px, 15vmin, 120px);
  /* Высота полей ввода */
  --control-height: clamp(28px, 3.5vmin, 32px);
  /* Высота элементов управления */
  --button-action-width: clamp(90px, 12vmin, 120px);
  /* Ширина кнопок действий */
  --icon-button-size: clamp(28px, 3.5vmin, 32px);
  /* Размер кнопок с иконками */
  --icon-size-small: clamp(18px, 2.3vmin, 22px);
  /* Размер маленьких иконок */

  /* Новые переменные для отступов */
  --spacing-xs: clamp(2px, 0.5vmin, 4px);
  /* Очень маленький отступ */
  --spacing-sm: clamp(4px, 0.8vmin, 6px);
  /* Маленький отступ */
  --spacing-md: clamp(8px, 1.2vmin, 12px);
  /* Средний отступ */
  --spacing-lg: clamp(12px, 1.8vmin, 16px);
  /* Большой отступ */

  /* Радиусы скругления */
  --border-radius-sm: clamp(3px, 0.5vmin, 4px);
  /* Маленький радиус */
  --border-radius-md: clamp(5px, 0.8vmin, 6px);
  /* Средний радиус */

  /* Цвета (Новая палитра v20.2) */
  --color-black-100: #000000;
  /* Чистый черный */
  --color-black-95: rgba(255, 255, 255, 0.05);
  /* 95% черный (5% белый на черном) */
  --color-black-66: rgba(255, 255, 255, 0.34);
  /* 66% черный (~34% белый) */
  --color-black-33: rgba(255, 255, 255, 0.67);
  /* 33% черный (~67% белый) */
  --color-white-100: #ffffff;
  /* Чистый белый */
  --color-green-100: #00cc00;
  /* Чистый зеленый */
  --color-red-100: #ff0000;
  /* Чистый красный */
  --color-purple-100: #800080;
  /* Чистый фиолетовый */

  /* Переопределение старых переменных (или их замена по всему файлу) */
  --color-pure-black: var(--color-black-100);
  --color-primary: var(--color-white-100);
  /* Основной текст - белый */
  --panel-bg: var(--color-black-100);
  /* Панели черные */
  --panel-border: var(--color-black-66);
  /* Границы панелей - темно-серые */
  --input-bg: var(--color-black-95);
  /* Фон инпутов - почти черный */
  --input-border: var(--color-black-66);
  /* Границы инпутов - темно-серые */
  --button-action-bg: #007bff;
  /* Оставим синий для кнопок действий */
  --button-action-hover: #0056b3;
  --button-hover-bg: rgba(255, 255, 255, 0.08);
  /* Фон кнопки при ховере */
  --color-icon: #888;
  /* Неактивная иконка - светло-серый */
  --color-icon-active: var(--color-white-100);
  /* Активная иконка - белый */
  --color-icon-disabled: var(--color-black-66);
  /* Отключенная иконка - темно-серый */
  --placeholder-bg: var(--color-black-95);
  /* Фон плейсхолдера - почти черный */
}

/* Адаптивность */
@media screen and (min-width: 1024px) {
  :root {
    /* Увеличиваем кнопки на больших экранах */
    --button-size: clamp(45px, 5vmin, 60px);
    --button-spacing: clamp(6px, 1vmin, 14px);
    --button-margin: clamp(8px, 2vmin, 16px);
  }
}
</file>

