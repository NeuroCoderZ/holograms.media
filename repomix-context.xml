                return true;
            } catch (e) {
                console.error("Error ending XR session:", e);
                return false;
            }
        }
        return false;
    }

    isSessionActive() {
        return this.xrSession !== null;
    }

    async toggleXRSession(xrButtonElement, sessionMode = 'immersive-vr') {
