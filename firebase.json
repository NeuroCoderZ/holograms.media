{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/webgpu-test",
        "destination": "/webgpu_test.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}