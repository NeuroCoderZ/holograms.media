{
  "output": {
    "filePath": "repomix-output.txt",
    "style": "plain",
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 10,
    "showLineNumbers": true,
    "copyToClipboard": false
  },
  "repomixVersion": "1.15.0",
  "include": [
    "js/**/*.js",
    "backend/**/*.py",
    "holocore/**/*.rs",
    "docs/ARCH/**/*.md",
    "docs/RU/*.md",
    "docs/EN/*.md",
    "QWEN.md",
    "AGENTS.md",
    "package.json",
    "version.txt"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.git/**",
      "**/.github/**",
      "**/.vscode/**",
      "**/.idea/**",
      "**/*.log",
      "**/*.lock",
      "**/*.tmp",
      "**/*.csv",
      "**/package-lock.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/.env*",
      "**/repomix-context.xml",
      "**/conductor/**",
      "**/brain/**",
      "**/scripts/debug_connection.py",
      "**/scripts/test_*.py",
      "**/reports/**",
      "**/screenshots/**",
      "**/docs/ARCH/RU/Legal/**",
      "**/docs/ARCH/RU/Guides/ManualTestingGuide.md"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
