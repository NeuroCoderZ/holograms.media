{
  "output": {
    "filePath": "repomix-output.txt",
    "style": "plain",
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 20,
    "showLineNumbers": true,
    "copyToClipboard": false
  },
  "repomixVersion": "1.18.0",
  "include": [
    "index.html",
    "style.css",
    "css/**/*.css",
    "js/**/*.js",
    "backend/**/*.py",
    "holocore/**/*.rs",
    "tools/**/*.js",
    "tools/**/*.mjs",
    "tests/unit/**/*.js",
    "tests/unit/**/*.mjs",
    "docs/*.md",
    "docs/ARCH/**/*.md",
    "docs/RU/*.md",
    "docs/EN/*.md",
    "PROGRESS.md",
    "HologramsMedia.md",
    "WEBGPU_MIGRATION.md",
    "WEB_STACK.md",
    "TOKENOMICS.md",
    "QWEN.md",
    "AGENTS.md",
    "package.json",
    "version.txt",
    "scripts/deploy.js",
    "scripts/run_tests.sh"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.git/**",
      "**/.github/**",
      "**/.vscode/**",
      "**/.idea/**",
      "**/*.log",
      "**/*.lock",
      "**/*.tmp",
      "**/*.csv",
      "**/package-lock.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/.env*",
      "**/repomix-context.xml",
      "**/conductor/**",
      "**/brain/**",
      "**/scripts/debug_connection.py",
      "**/scripts/test_*.py",
      "**/reports/**",
      "**/screenshots/**",
      "**/docs/ARCH/RU/Legal/**",
      "**/docs/ARCH/RU/Guides/ManualTestingGuide.md",
      "**/.wasm-backup-*/**",
      "**/*.wasm",
      "**/public/wasm/**",
      "**/js/vendor/**",
      "**/docs/archive/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
